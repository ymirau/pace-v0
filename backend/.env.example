# LOCAL DEVELOPMENT ONLY. /syn-init-webapp copies this file to backend/.env, which the
# backend reads when you run it on your machine (uvicorn, pytest). backend/.env is
# git-ignored: never commit it, and never put one on a server. Deployed envs get their
# settings from _deploy/envs/<slug>-<env>.env and their secrets from /etc/<slug>-<env>.env.
# See README.md → Config files.

# --- Pace chat agent ---
# The agent the chat UI talks to. Without a key, /chat/open and /chat/message
# return 503; the rest of the app still works.
ANTHROPIC_API_KEY=
PACE_MODEL=claude-sonnet-5-5
# Which seed to load: example (Maya / Kiln & Co) or mine (your own business,
# copied from app/pace/data/seed_blank.json to seed_mine.json).
PACE_SEED=example

# Async SQLAlchemy URL for the shared Synveon Postgres — note the +asyncpg driver.
# pytest runs against this same database and rolls back every change.
POSTGRES_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Local Postgres: /syn-init-local-postgres-db fills this in without a password. When
# the toolkit's WSL setup saved app_admin's password in ~/.pgpass (asyncpg reads it),
# the app runs as that limited role, like sbx/uat/prod:
#   POSTGRES_URL=postgresql+asyncpg://app_admin@localhost:5432/synveon_loc
# otherwise as you over the local socket:
#   POSTGRES_URL=postgresql+asyncpg://<you>@/synveon_loc?host=/var/run/postgresql

# --- SQL Server (optional read/write source) ---
# Powers the /api/reports/* endpoints. Left blank, those return 503 and the rest
# of the app works normally. SQL Server authentication (user + password) only.
# Needs Microsoft's ODBC Driver 18 (scripts/setup-wsl-dev.sh installs it).
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Optional overrides (defaults shown):
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# SQLSERVER_ENCRYPT=yes
# SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
# SQLSERVER_LOGIN_TIMEOUT=10
# SQLSERVER_QUERY_TIMEOUT=60

# --- Email (notification mail and the support form) ---
# Plain SMTP to Office 365's connector for example.com (no login, nothing secret).
# Off here, so running locally never emails anyone: with MAIL_ENABLED=false the app
# logs what it would have sent (the support form says so). To try it, set
# MAIL_ENABLED=true and keep MAIL_REDIRECT_TO on your own address.
MAIL_ENABLED=false
MAIL_SMTP_HOST=example-com.mail.protection.outlook.com
MAIL_SMTP_PORT=25
MAIL_STARTTLS=true
MAIL_SENDER=no-reply@example.com
MAIL_REDIRECT_TO=injic05@gmail.com
# Where the Support page sends.
SUPPORT_EMAIL=injic05@gmail.com

# Skip Azure token validation and treat every request as a dev user. This file is for
# your machine only, where the SPA (served over plain HTTP) skips sign-in and sends no
# token, so it's on. A deployed env refuses to start with it set (ENV_NAME guard in
# app/core/config.py).
AUTH_DISABLED=true

# CORS is for deployed envs only (set in _deploy/envs/<slug>-<env>.env). Leave it
# unset locally: the Vite proxy makes requests same-origin.
# CORS_ALLOW_ORIGINS=https://apps.example.com
