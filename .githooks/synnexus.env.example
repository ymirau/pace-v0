# Shared synnexus MinIO connection for product-workflow publishing: the pre-push hook
# and the workflow skills mirror _workitems/features/ to this bucket.
#
# Lives at ~/.config/synnexus.env: one file per machine, reused by every project, and
# separate from any project's backend MINIO_* config. Fill in SYNNEXUS_SECRET_KEY
# yourself (never in a chat); the sync is skipped with a one-line warning until you do.
#
# This example is the one source of these values: the toolkit's WSL setup
# (scripts/setup-wsl-dev.sh) and /syn-sync-workitems both copy it as is. To create the
# file by hand:
#     mkdir -p ~/.config && (umask 077 && cp .githooks/synnexus.env.example ~/.config/synnexus.env)
#
# Neither one overwrites an existing ~/.config/synnexus.env. If these values change
# (a new endpoint, access key or bucket), update ~/.config/synnexus.env by hand on each
# machine; re-running the setup won't do it.

SYNNEXUS_ENDPOINT=http://app-server-01:9010
SYNNEXUS_ACCESS_KEY=synnexus-user
SYNNEXUS_SECRET_KEY=
SYNNEXUS_BUCKET=synnexus
