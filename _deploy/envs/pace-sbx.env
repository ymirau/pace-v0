# SETTINGS for the SBX environment of pace-v0: committed, no secrets.
# Loaded by systemd (EnvironmentFile, read from the deployed checkout) for the backend,
# and sourced by _deploy/scripts/install.sh and deploy.sh. Secrets go in the host file
# /etc/pace-sbx.env instead (template: _deploy/envs/pace.secrets.env.example).
# See README.md → Config files.
#
# Runs on app-server-02, served at https://apps.example.com/pace-sbx/ via
# Azure App Proxy + the shared Caddy.

ENV_NAME=pace-sbx

# Single shared hostname for all envs (resolved via Azure App Proxy / DNS).
SITE_HOSTNAME=apps.example.com

# Origins the backend allows for CORS (the SPA is served from the shared host).
CORS_ALLOW_ORIGINS=https://apps.example.com

# URL path this env is served under (trailing slash required). Vite bakes this
# in as the build base; Caddy routes <base>api/* to API_PORT and serves the SPA
# from <base>*.
SPA_BASE_PATH=/pace-sbx/

# Host this env runs on (shared with operator-app and other path-routed apps).
TARGET_HOST=app-server-02

# System user the FastAPI service runs as. SBX has its own user (isolated from the
# prod-grade envs); UAT/PROD share `synapps-pace`. CONFIRM with the platform owner.
SERVICE_USER=synappssbx-pace

# Repo checkout root (app-specific — must not collide with operator-app's
# /opt/synveon/<tier>) and built-SPA destination on the target host.
INSTALL_ROOT=/opt/synveon/pace-sbx
# Dist lives at DIST_ROOT/SPA_SEGMENT = /var/www/html/pace-sbx. DIST_ROOT is
# the parent (Caddy's `root`); SPA_SEGMENT is the URL base path component appended
# by Caddy's try_files. pace's dist dirs sit DIRECTLY under /var/www/html as
# siblings of operator-app's /var/www/html/<tier>, so operator-app's
# `chown -R DIST_ROOT` can never reach them.
DIST_ROOT=/var/www/html
SPA_SEGMENT=pace-sbx

# Port uvicorn binds. MUST be unique on the shared host — operator-app uses
# 8002/8003/8004; confirm a free block with the platform owner before install.
API_PORT=8014

# Vite build target — selects base path in vite.config.ts (npm run build:sbx).
BUILD_TARGET=sbx

# Postgres (shared instance; app tables isolated in the `pace` schema).
# Non-secret coordinates only; password is in the host secret file.
PG_HOST=app-server-01
PG_PORT=5432
PG_DATABASE=synveon_dev
PG_USER=app_admin

# SQL Server (OPTIONAL — powers the /api/reports/* endpoints). Non-secret
# coordinates only; SQLSERVER_PASSWORD goes in the host secret file
# /etc/pace-sbx.env. Commented out = reports disabled (endpoints return 503).
# To enable: uncomment here AND set SQLSERVER_PASSWORD in the host secret file.
# The host also needs Microsoft's ODBC Driver 18 (install.sh checks for it).
# SQLSERVER_HOST=DB-SERVER-01.EXAMPLE.COM
# SQLSERVER_PORT=1433
# SQLSERVER_DATABASE=
# SQLSERVER_USER=

# Email (notification mail and the Support page). Plain SMTP to Office 365's
# connector for example.com, which accepts mail from Synveon's IPs: no login, nothing
# secret, nothing in the host secret file. Set MAIL_ENABLED=false to stop all mail.
MAIL_ENABLED=true
MAIL_SMTP_HOST=example-com.mail.protection.outlook.com
MAIL_SMTP_PORT=25
MAIL_STARTTLS=true
MAIL_SENDER=no-reply@example.com
# MAIL_REDIRECT_TO sends every message to that one inbox instead of its recipient,
# naming who it was for: keep it set on sbx so testing never emails real people.
MAIL_REDIRECT_TO=injic05@gmail.com
# Where the Support page sends (/syn-init-webapp fills in the developer's address;
# change it to the team's support inbox).
SUPPORT_EMAIL=injic05@gmail.com
