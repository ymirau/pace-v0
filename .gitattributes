# Default: treat all files as text and normalize line endings to LF in the repo.
# Working tree checkouts will also use LF, regardless of platform.
* text=auto eol=lf

# Windows-native scripts must keep CRLF or they may fail to execute.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Common binary types — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.whl   binary
*.so    binary
*.dll   binary
*.exe   binary
