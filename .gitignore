# Secrets — NEVER commit
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Language / build artifacts
node_modules/
dist/
build/
artifacts/
.vite/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
wheels/
*.egg-info/
.pytest_cache/
**/.ruff_cache/
.mypy_cache/

# OS / editor
.DS_Store
Thumbs.db
# Keep the shared workspace settings/extensions; ignore user-local VSCode state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Claude Code session state (per-project) — drop if a subdirectory has one, it's local only
**/.claude/settings.local.json

# The scratch dir is ephemeral screenshots/notes — tracked dir, ignored contents
/_scratch/*
!/_scratch/.gitkeep

# Playwright test output
test-results/
playwright-report/
.playwright-mcp/

# Logs
*.log
npm-debug.log*

# Deploy targets (Caddy reads these — not source)
# (None under /opt/synveon/ — they live at /var/www/html/)

# Rendered systemd / Caddy config (regenerated by _deploy/scripts/render.sh on each install)
_deploy/rendered/

# Per-app backups we keep around for rollback but don't commit
*.pre-deadcode-*
*.pre-cutover-*
*.old-20*
*.old.2*

# JS/TS test + cache outputs
coverage/
.nyc_output/
.eslintcache
*.local

# Temp folders
**/temp
**/tmp
**/.temp

# CI deploy: ssh-agent PID stash (created/removed within the deploy job)
.ssh_agent_pid

# Ralph runner per-run state (_workitems product workflow) — prd.json is tracked
_workitems/ralph/progress.txt
_workitems/ralph/archive/
_workitems/ralph/.last-branch
_workitems/ralph/.last-story
_workitems/ralph/.story-attempts

# Pace chat engine: live state and session transcripts
backend/app/pace/data/state.json
backend/app/pace/data/seed_mine.json
backend/app/pace/transcripts/
.vercel
.env*

# Byproducts of `vercel build` run at the repo root: a pyproject.toml and lock
# synthesised from requirements.txt, and the wheels it installs (~55 MB). All
# regenerated on demand; none of them describe this repo.
/.vercel_python_packages/
/pyproject.toml
/uv.lock
